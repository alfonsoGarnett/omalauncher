#!/usr/bin/env python3
"""adb-admin: privileged Android controls over ADB (shell user, no root).

Used by ~/.config/omalauncher/widgets/36-adb-admin.owl. Reports go to
~/.cache/adb-admin/*.json (read by the widget's file sources); every change
is logged to ~/.local/share/adb-admin/log.jsonl with the command that undoes it.

  adb-admin status                      connection + quick toggles (JSON on stdout)
  adb-admin apps                        refresh apps.json
  adb-admin do ACTION PKG...            freeze unfreeze suspend unsuspend remove restore
                                        stop clear cache  (PKGs may be one space-joined word)
  adb-admin undo                        undo the last batch
  adb-admin app PKG                     details -> app.json
  adb-admin grant|revoke PKG PERM
  adb-admin appop PKG OP MODE           allow ignore deny foreground default
  adb-admin bucket PKG BUCKET           active working_set frequent rare restricted
  adb-admin idle PKG on|off             doze whitelist
  adb-admin preset NAME                 debloat preset (writes presets.json)
  adb-admin report KIND                 audit battery memory cpu storage crash anr apks log startup
  adb-admin restrict|unrestrict PKG...  background running (RUN_ANY_IN_BACKGROUND), one undoable batch
  adb-admin set NS KEY VALUE|null       settings put/delete, with undo
  adb-admin dns off|auto|HOST
  adb-admin anim SCALE
  adb-admin density N|reset
  adb-admin size WxH|reset              screen resolution (wm size)
  adb-admin rotate on|off               auto-rotate; off also locks the screen upright
  adb-admin stock                       resolution, density, font size and animations back to stock (undoable)
  adb-admin toggle wifi|bt|data|airplane on|off
  adb-admin default ROLE PKG            browser dialer sms home assistant
  adb-admin killall | shot | record SECS | reboot system|recovery|bootloader
  adb-admin install PATH | extract PKG | export NAME | import NAME | grantwss

  adb-admin --watch COMMAND...          the same commands on the Wear OS watch found by watch-link,
                                        with its own reports (~/.cache/adb-admin/watch) and undo log, plus:
  adb-admin --watch input TEXT          type text into the focused field on the watch
  adb-admin --watch key back|home|wake|sleep|power
  adb-admin --watch launch PKG          open an app on the watch
  adb-admin --watch buzz                vibrate the watch to find it
  adb-admin --watch swipe up|down|left|right   the finger moves that way (up scrolls a list down)
  adb-admin --watch bezel N             turn the rotating bezel N steps (negative: counter-clockwise)
  adb-admin --watch tap X Y             tap at screen pixels
  adb-admin --watch face COMPONENT      set the watch face (report faces lists them)
  adb-admin --watch push PATH           copy a file to the watch (audio to Music, the rest to Download)
  adb-admin --watch wifi on|auto|off    the watch's Wi-Fi mode; on also turns off automatic Wi-Fi
                                        (developer option) so the link stays up
"""
import json, os, re, subprocess, sys, time, glob

WATCH = len(sys.argv) > 1 and sys.argv[1] == "--watch"
if WATCH:
    del sys.argv[1]
SERIAL = os.environ.get("ADB_SERIAL", "127.0.0.1:5556")
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache/adb-admin/watch" if WATCH else ".cache/adb-admin")
DATA = os.path.join(HOME, ".local/share/adb-admin/watch" if WATCH else ".local/share/adb-admin")
LOG = os.path.join(DATA, "log.jsonl")
LAUNCHER = "dev.omalauncher.mod"
PKG_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._]*$")
KEY_RE = re.compile(r"^[A-Za-z0-9_.]+$")
os.makedirs(CACHE, exist_ok=True)
os.makedirs(DATA, exist_ok=True)

