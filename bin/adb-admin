#!/usr/bin/env python3
"""adb-admin: privileged Android controls over ADB (shell user, no root).

Used by ~/.config/omalauncher/widgets/36-adb-admin.owl. Reports go to
~/.cache/adb-admin/*.json (read by the widget's file sources); every change
is logged to ~/.local/share/adb-admin/log.jsonl with the command that undoes it.

  adb-admin status                      connection + quick toggles (JSON on stdout)
  adb-admin apps                        refresh apps.json
  adb-admin do ACTION PKG...            freeze unfreeze suspend unsuspend remove restore
                                        stop clear cache  (PKGs may be one space-joined word)
  adb-admin undo                        undo the last batch
  adb-admin app PKG                     details -> app.json
  adb-admin grant|revoke PKG PERM
  adb-admin appop PKG OP MODE           allow ignore deny foreground default
  adb-admin bucket PKG BUCKET           active working_set frequent rare restricted
  adb-admin idle PKG on|off             doze whitelist
  adb-admin preset NAME                 debloat preset (writes presets.json)
  adb-admin report KIND                 audit battery memory cpu storage crash anr apks log startup
  adb-admin restrict|unrestrict PKG...  background running (RUN_ANY_IN_BACKGROUND), one undoable batch
  adb-admin set NS KEY VALUE|null       settings put/delete, with undo
  adb-admin dns off|auto|HOST
  adb-admin anim SCALE
  adb-admin density N|reset
  adb-admin toggle wifi|bt|data|airplane on|off
  adb-admin default ROLE PKG            browser dialer sms home assistant
  adb-admin killall | shot | record SECS | reboot system|recovery|bootloader
  adb-admin install PATH | extract PKG | export NAME | import NAME | grantwss
"""
import json, os, re, subprocess, sys, time, glob

