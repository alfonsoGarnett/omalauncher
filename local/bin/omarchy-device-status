#!/usr/bin/env python3
"""
omarchy-device-status: a native GTK3 window (through ctypes on libgtk-3.so.0) showing the Android phone's
battery, temperature, voltage and health.
"""
import ctypes
import json
import os
import re
import subprocess
import sys

def ensure_wayland_env():
    if not os.environ.get("WAYLAND_DISPLAY"):
        if os.path.exists("/run/user/0/wayland-1"):
            os.environ["WAYLAND_DISPLAY"] = "wayland-1"
        elif os.path.exists("/run/user/0/wayland-0"):
            os.environ["WAYLAND_DISPLAY"] = "wayland-0"
    os.environ["GDK_BACKEND"] = "wayland"

def get_device_data():
    data = {
        'level': 0,
        'status_str': 'Unknown',
        'health_str': 'Good',
        'plug_str': 'Unplugged (on battery)',
        'temp_str': 'N/A',
        'volt_str': 'N/A',
        'tech': 'Li-ion',
        'counter': 'N/A',
        'model': 'Android Host',
        'android': 'Android',
        'uptime': 'Up',
    }

    # 1. Live data that Omalauncher exports (/run/user/0/android-status.json)
    status_candidates = [
        "/run/user/0/android-status.json",
        os.path.expanduser("~/.local/share/omarchy/android-status.json"),
    ]
    for status_file in status_candidates:
        if os.path.exists(status_file):
            try:
                with open(status_file, "r", encoding="utf-8") as f:
                    sdata = json.load(f)
                bat = sdata.get("battery", sdata)
                if isinstance(bat, dict) and bat:
                    if 'level' in bat:
                        data['level'] = int(bat.get('level', 0))
                    st = str(bat.get('status', '')).lower()
                    status_map = {
                        'charging': ' Charging',
                        'discharging': '  Discharging',
                        'full': '  Full',
                        'not_charging': '⏸ Not charging'
                    }
                    if st:
                        data['status_str'] = status_map.get(st, st.capitalize())
                    plug = str(bat.get('plugged', '')).lower()
                    plug_map = {
                        'ac': ' AC charger',
                        'usb': ' USB',
                        'wireless': ' Wireless charging',
                        'unplugged': '  On battery'
                    }
                    if plug:
                        data['plug_str'] = plug_map.get(plug, plug.capitalize())
                    if 'temperature' in bat and bat['temperature'] is not None:
                        data['temp_str'] = f"{float(bat['temperature']):.1f} °C"
                    if 'voltage_mv' in bat and bat['voltage_mv']:
                        data['volt_str'] = f"{float(bat['voltage_mv']) / 1000.0:.2f} V"
                dev = sdata.get("device", {})
                if isinstance(dev, dict):
                    if dev.get("model"):
                        data['model'] = dev["model"]
                    if dev.get("release"):
                        data['android'] = f"Android {dev['release']}"
            except Exception:
                pass

    # 2. More detail from ADB (when it's connected)
    try:
        serial = os.environ.get("ANDROID_SERIAL", "127.0.0.1:5556")
        adb_target = ['adb', '-s', serial]

        def get_prop(prop):
            try:
                return subprocess.check_output(
                    adb_target + ['shell', 'getprop', prop],
                    stderr=subprocess.DEVNULL,
                    timeout=1.5
                ).decode('utf-8', errors='ignore').strip()
            except Exception:
                return ''

        brand = get_prop('ro.product.brand').capitalize()
        model = get_prop('ro.product.model')
        market_name = get_prop('ro.product.marketname')
        if market_name:
            data['model'] = market_name
        elif brand or model:
            data['model'] = f"{brand} {model}".strip()

        rel = get_prop('ro.build.version.release')
        sdk = get_prop('ro.build.version.sdk')
        if rel:
            data['android'] = f"Android {rel}" + (f" (SDK {sdk})" if sdk else "")

        try:
            up = subprocess.check_output(
                adb_target + ['shell', 'uptime'],
                stderr=subprocess.DEVNULL,
                timeout=1.5
            ).decode('utf-8', errors='ignore').strip()
            if 'up ' in up:
                data['uptime'] = up.split('up ')[-1].split(',')[0].strip()
            elif up:
                data['uptime'] = up
        except Exception:
            pass

        out = subprocess.check_output(
            adb_target + ['shell', 'dumpsys', 'battery'],
            stderr=subprocess.DEVNULL,
            timeout=2.0
        ).decode('utf-8', errors='ignore')

        level_m = re.search(r'level:\s*(\d+)', out)
        if level_m:
            data['level'] = int(level_m.group(1))

        status_m = re.search(r'status:\s*(\d+)', out)
        if status_m:
            st = int(status_m.group(1))
            status_map = {
                1: 'Unknown',
                2: ' Charging',
                3: '  Discharging',
                4: '⏸ Not charging',
                5: '  Full'
            }
            data['status_str'] = status_map.get(st, f'Status {st}')

        health_m = re.search(r'health:\s*(\d+)', out)
        if health_m:
            hl = int(health_m.group(1))
            health_map = {
                1: 'Unknown',
                2: ' Good',
                3: ' Overheating',
                4: ' Degraded',
                5: ' Over voltage',
                6: ' Failure'
            }
            data['health_str'] = health_map.get(hl, f'Code {hl}')

        ac_m = re.search(r'AC powered:\s*(\w+)', out)
        usb_m = re.search(r'USB powered:\s*(\w+)', out)
        wl_m = re.search(r'Wireless powered:\s*(\w+)', out)
        if ac_m and ac_m.group(1) == 'true':
            data['plug_str'] = ' AC charger'
        elif usb_m and usb_m.group(1) == 'true':
            data['plug_str'] = ' USB'
        elif wl_m and wl_m.group(1) == 'true':
            data['plug_str'] = ' Wireless charging'
        else:
            data['plug_str'] = '  On battery'

        temp_m = re.search(r'^\s*temperature:\s*(\d+)', out, re.MULTILINE)
        if temp_m:
            t = int(temp_m.group(1)) / 10.0
            data['temp_str'] = f"{t:.1f} °C"

        volt_m = re.search(r'^\s*voltage:\s*(\d+)', out, re.MULTILINE)
        if volt_m:
            v = int(volt_m.group(1)) / 1000.0
            data['volt_str'] = f"{v:.2f} V"

        tech_m = re.search(r'technology:\s*(\S+)', out)
        if tech_m:
            data['tech'] = tech_m.group(1)

        cc_m = re.search(r'charge counter:\s*(\d+)', out)
        if cc_m:
            data['counter'] = f"{int(cc_m.group(1)) // 1000} mAh ({data['tech']})"
    except Exception:
        pass

    return data

def show_gui():
    ensure_wayland_env()

    glib = ctypes.CDLL("libglib-2.0.so.0")
    gobj = ctypes.CDLL("libgobject-2.0.so.0")
    gdk = ctypes.CDLL("libgdk-3.so.0")
    gtk = ctypes.CDLL("libgtk-3.so.0")

    # Declare the C prototypes
    glib.g_set_prgname.argtypes = [ctypes.c_char_p]
    glib.g_set_application_name.argtypes = [ctypes.c_char_p]
    glib.g_timeout_add_seconds.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
    glib.g_timeout_add_seconds.restype = ctypes.c_uint

    gtk.gtk_init.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    gtk.gtk_window_new.argtypes = [ctypes.c_int]
    gtk.gtk_window_new.restype = ctypes.c_void_p
    gtk.gtk_window_set_title.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    gtk.gtk_window_set_default_size.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
    gtk.gtk_window_set_position.argtypes = [ctypes.c_void_p, ctypes.c_int]
    gtk.gtk_container_set_border_width.argtypes = [ctypes.c_void_p, ctypes.c_uint]
    gtk.gtk_container_add.argtypes = [ctypes.c_void_p, ctypes.c_void_p]

    gtk.gtk_css_provider_new.restype = ctypes.c_void_p
    gtk.gtk_css_provider_load_from_data.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_ssize_t, ctypes.c_void_p]
    gdk.gdk_screen_get_default.restype = ctypes.c_void_p
    gtk.gtk_style_context_add_provider_for_screen.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint]
    gtk.gtk_widget_get_style_context.argtypes = [ctypes.c_void_p]
    gtk.gtk_widget_get_style_context.restype = ctypes.c_void_p
    gtk.gtk_style_context_add_class.argtypes = [ctypes.c_void_p, ctypes.c_char_p]

    gtk.gtk_box_new.argtypes = [ctypes.c_int, ctypes.c_int]
    gtk.gtk_box_new.restype = ctypes.c_void_p
    gtk.gtk_box_pack_start.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_uint]
    gtk.gtk_box_pack_end.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_uint]

    gtk.gtk_label_new.argtypes = [ctypes.c_char_p]
    gtk.gtk_label_new.restype = ctypes.c_void_p
    gtk.gtk_label_set_text.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    gtk.gtk_widget_set_halign.argtypes = [ctypes.c_void_p, ctypes.c_int]

    gtk.gtk_progress_bar_new.restype = ctypes.c_void_p
    gtk.gtk_progress_bar_set_fraction.argtypes = [ctypes.c_void_p, ctypes.c_double]

    gtk.gtk_grid_new.restype = ctypes.c_void_p
    gtk.gtk_grid_set_column_spacing.argtypes = [ctypes.c_void_p, ctypes.c_uint]
    gtk.gtk_grid_set_row_spacing.argtypes = [ctypes.c_void_p, ctypes.c_uint]
    gtk.gtk_grid_attach.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int]

    gtk.gtk_button_new_with_label.argtypes = [ctypes.c_char_p]
    gtk.gtk_button_new_with_label.restype = ctypes.c_void_p
    gtk.gtk_widget_show_all.argtypes = [ctypes.c_void_p]
    gtk.gtk_widget_destroy.argtypes = [ctypes.c_void_p]

    gobj.g_signal_connect_data.argtypes = [
        ctypes.c_void_p, ctypes.c_char_p, ctypes.c_void_p,
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int
    ]
    gobj.g_signal_connect_data.restype = ctypes.c_ulong

    def add_class(widget, cls_name):
        ctx = gtk.gtk_widget_get_style_context(widget)
        gtk.gtk_style_context_add_class(ctx, cls_name.encode('utf-8'))

    glib.g_set_prgname(b"omarchy-device-status")
    glib.g_set_application_name(b"Omarchy Telemetry")
    gtk.gtk_init(None, None)

    data = get_device_data()

    try:
        subprocess.run([
            'notify-send', '-a', 'omarchy',
            f"󰯃 {data['model']}: {data['level']}%",
            f"{data['status_str']} | {data['temp_str']} | {data['health_str']}"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    window = gtk.gtk_window_new(0)
    gtk.gtk_window_set_title(window, "󰞖 Phone telemetry and health [1337]".encode('utf-8'))
    gtk.gtk_window_set_default_size(window, 460, 490)
    gtk.gtk_window_set_position(window, 1)  # GTK_WIN_POS_CENTER
    gtk.gtk_container_set_border_width(window, 16)

    css = b"""
    * {
        font-family: "JetBrains Mono", "Symbols Nerd Font Mono", "DejaVu Sans Mono", monospace;
    }
    window {
        background-color: #1a1b26;
        color: #c0caf5;
        border: 2px solid #7aa2f7;
    }
    .header-box {
        background-color: #16161e;
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 10px;
        border: 1px solid #414868;
    }
    .title-banner {
        font-size: 12px;
        font-weight: bold;
        color: #e0af68;
    }
    .level-text {
        font-size: 28px;
        font-weight: bold;
        color: #9ece6a;
    }
    .status-badge {
        font-size: 13px;
        color: #7dcfff;
        font-weight: bold;
    }
    .grid-card {
        background-color: #16161e;
        border-radius: 8px;
        padding: 14px;
        border: 1px solid #414868;
    }
    .prop-name {
        font-size: 12px;
        color: #7aa2f7;
        font-weight: bold;
    }
    .prop-val {
        font-size: 13px;
        color: #c0caf5;
        font-weight: bold;
    }
    progressbar trough {
        min-height: 12px;
        border-radius: 4px;
        background-color: #24283b;
    }
    progressbar progress {
        min-height: 12px;
        border-radius: 4px;
        background-color: #9ece6a;
    }
    button.refresh-btn {
        background-color: #24283b;
        color: #7dcfff;
        border-radius: 6px;
        padding: 8px 14px;
        border: 1px solid #7dcfff;
        font-weight: bold;
    }
    button.refresh-btn:hover {
        background-color: #7dcfff;
        color: #16161e;
    }
    button.close-btn {
        background-color: #f7768e;
        color: #16161e;
        border-radius: 6px;
        padding: 8px 14px;
        border: none;
        font-weight: bold;
    }
    button.close-btn:hover {
        background-color: #ff9e64;
    }
    """
    provider = gtk.gtk_css_provider_new()
    gtk.gtk_css_provider_load_from_data(provider, css, len(css), None)
    screen = gdk.gdk_screen_get_default()
    gtk.gtk_style_context_add_provider_for_screen(screen, provider, 600)

    # Orientation: 0 = HORIZONTAL, 1 = VERTICAL
    # Align: 1 = START, 2 = END, 3 = CENTER
    main_box = gtk.gtk_box_new(1, 12)
    gtk.gtk_container_add(window, main_box)

    header_box = gtk.gtk_box_new(1, 8)
    add_class(header_box, "header-box")

    lbl_banner = gtk.gtk_label_new("󰞖 PHOENIX // LIVE ANDROID TELEMETRY".encode('utf-8'))
    add_class(lbl_banner, "title-banner")
    gtk.gtk_widget_set_halign(lbl_banner, 1)
    gtk.gtk_box_pack_start(header_box, lbl_banner, 0, 0, 0)

    top_row = gtk.gtk_box_new(0, 10)
    lbl_level = gtk.gtk_label_new(f"  {data['level']}%".encode('utf-8'))
    add_class(lbl_level, "level-text")
    gtk.gtk_box_pack_start(top_row, lbl_level, 0, 0, 0)

    lbl_status = gtk.gtk_label_new(data['status_str'].encode('utf-8'))
    add_class(lbl_status, "status-badge")
    gtk.gtk_widget_set_halign(lbl_status, 2)
    gtk.gtk_box_pack_end(top_row, lbl_status, 0, 0, 0)
    gtk.gtk_box_pack_start(header_box, top_row, 0, 0, 0)

    prog = gtk.gtk_progress_bar_new()
    gtk.gtk_progress_bar_set_fraction(prog, max(0.0, min(1.0, data['level'] / 100.0)))
    gtk.gtk_box_pack_start(header_box, prog, 0, 0, 0)
    gtk.gtk_box_pack_start(main_box, header_box, 0, 0, 0)

    grid_card = gtk.gtk_box_new(1, 10)
    add_class(grid_card, "grid-card")

    grid = gtk.gtk_grid_new()
    gtk.gtk_grid_set_column_spacing(grid, 18)
    gtk.gtk_grid_set_row_spacing(grid, 10)
    gtk.gtk_box_pack_start(grid_card, grid, 1, 1, 0)

    def build_rows(d):
        return [
            ("󰄝 Device:", d['model']),
            (" System:", d['android']),
            (" Power:", d['plug_str']),
            (" Temperature:", d['temp_str']),
            (" Voltage:", d['volt_str']),
            (" Battery health:", d['health_str']),
            ("  Capacity:", d['counter']),
            ("󱑂 Uptime:", d['uptime']),
        ]

    val_labels = {}
    for row_idx, (k, v) in enumerate(build_rows(data)):
        lk = gtk.gtk_label_new(k.encode('utf-8'))
        add_class(lk, "prop-name")
        gtk.gtk_widget_set_halign(lk, 1)
        gtk.gtk_grid_attach(grid, lk, 0, row_idx, 1, 1)

        lv = gtk.gtk_label_new(str(v).encode('utf-8'))
        add_class(lv, "prop-val")
        gtk.gtk_widget_set_halign(lv, 1)
        gtk.gtk_grid_attach(grid, lv, 1, row_idx, 1, 1)
        val_labels[k] = lv

    gtk.gtk_box_pack_start(main_box, grid_card, 1, 1, 0)

    btn_box = gtk.gtk_box_new(0, 10)
    gtk.gtk_widget_set_halign(btn_box, 2)

    def do_refresh():
        nd = get_device_data()
        gtk.gtk_label_set_text(lbl_level, f"  {nd['level']}%".encode('utf-8'))
        gtk.gtk_progress_bar_set_fraction(prog, max(0.0, min(1.0, nd['level'] / 100.0)))
        gtk.gtk_label_set_text(lbl_status, nd['status_str'].encode('utf-8'))
        for k, v in build_rows(nd):
            if k in val_labels:
                gtk.gtk_label_set_text(val_labels[k], str(v).encode('utf-8'))

    btn_refresh = gtk.gtk_button_new_with_label("  Refresh".encode('utf-8'))
    add_class(btn_refresh, "refresh-btn")

    btn_close = gtk.gtk_button_new_with_label("✕  Close".encode('utf-8'))
    add_class(btn_close, "close-btn")

    gtk.gtk_box_pack_start(btn_box, btn_refresh, 0, 0, 0)
    gtk.gtk_box_pack_start(btn_box, btn_close, 0, 0, 0)
    gtk.gtk_box_pack_start(main_box, btn_box, 0, 0, 0)

    # C callbacks (kept in a list so they aren't garbage collected)
    CB_CLICK = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p)
    CB_DESTROY = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p)
    CB_TIMER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)

    def on_refresh_clicked(w, u):
        do_refresh()

    def on_close_clicked(w, u):
        gtk.gtk_widget_destroy(window)

    def on_destroy(w, u):
        gtk.gtk_main_quit()

    def on_timer(u):
        do_refresh()
        return 1

    c_refresh = CB_CLICK(on_refresh_clicked)
    c_close = CB_CLICK(on_close_clicked)
    c_destroy = CB_DESTROY(on_destroy)
    c_timer = CB_TIMER(on_timer)

    gobj.g_signal_connect_data(btn_refresh, b"clicked", c_refresh, None, None, 0)
    gobj.g_signal_connect_data(btn_close, b"clicked", c_close, None, None, 0)
    gobj.g_signal_connect_data(window, b"destroy", c_destroy, None, None, 0)
    glib.g_timeout_add_seconds(5, c_timer, None)

    gtk.gtk_widget_show_all(window)
    gtk.gtk_main()

def main():
    ensure_wayland_env()
    if os.environ.get('WAYLAND_DISPLAY') or os.environ.get('DISPLAY'):
        try:
            show_gui()
            return
        except Exception as e:
            print(f"Could not show the window: {e}", file=sys.stderr)

    data = get_device_data()
    print(f"󰄝 {data['model']} ({data['android']})")
    print(f"  Battery: {data['level']}% - {data['status_str']}")
    print(f" Power: {data['plug_str']}")
    print(f" Temp: {data['temp_str']} | Voltage: {data['volt_str']} | Health: {data['health_str']}")

if __name__ == '__main__':
    main()
