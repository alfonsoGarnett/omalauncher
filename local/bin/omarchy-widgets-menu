#!/usr/bin/env python3
import subprocess, glob, os, sys

def ensure_wayland_env():
    if not os.environ.get("WAYLAND_DISPLAY"):
        if os.path.exists("/run/user/0/wayland-1"):
            os.environ["WAYLAND_DISPLAY"] = "wayland-1"
        elif os.path.exists("/run/user/0/wayland-0"):
            os.environ["WAYLAND_DISPLAY"] = "wayland-0"
    os.environ["GDK_BACKEND"] = "wayland"

def refresh_all_widgets():
    widgets_dir = os.path.expanduser("~/.config/omalauncher/widgets")
    owl_files = glob.glob(os.path.join(widgets_dir, "*.owl"))
    count = 0
    for f in owl_files:
        name = os.path.basename(f)
        if name.startswith('.'):
            continue
        try:
            subprocess.run(['owl-send', name, 'refresh'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1)
            count += 1
        except Exception:
            pass
    subprocess.run(['notify-send', '-a', 'omarchy', '󰞖 Omalauncher', f'Refreshed {count} widgets on the phone.'])

def main():
    ensure_wayland_env()
    options = [
        "  Tiling shortcuts cheatsheet",
        "󰍽  Mouse and scroll speed",
        "󰞖  Open a widget on the desktop (Phoenix Widget Viewer)",
        "  Phone battery and health (live)",
        "  Refresh all Omalauncher widgets",
        "  Edit widgets (Neovim in ~/.config/omalauncher/widgets)",
        "  Check widgets (owl-check)",
        "󰯃  Android app launcher",
    ]

    subprocess.run(['pkill', '-x', 'wofi'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p = subprocess.Popen(
        ['wofi', '--dmenu', '-i', '-p', '󰞖 Phoenix widgets & telemetry:'],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True
    )
    chosen, _ = p.communicate(input="\n".join(options))
    chosen = chosen.strip()

    if not chosen:
        return

    env = os.environ.copy()
    if "cheatsheet" in chosen:
        subprocess.Popen(['foot', '--app-id=omarchy-cheatsheet', '-e', '/root/.local/bin/omarchy-cheatsheet'], env=env, start_new_session=True)
    elif "Mouse" in chosen:
        subprocess.Popen(['/root/.local/bin/omarchy-mouse-gui'], env=env, start_new_session=True)
    elif "Open a widget" in chosen:
        subprocess.Popen(['/root/.local/bin/omarchy-widget-viewer'], env=env, start_new_session=True)
    elif "battery" in chosen:
        subprocess.Popen(['/root/.local/bin/omarchy-device-status'], env=env, start_new_session=True)
    elif "Refresh all" in chosen:
        refresh_all_widgets()
    elif "Edit widgets" in chosen:
        subprocess.Popen(['foot', '-e', 'nvim', os.path.expanduser('~/.config/omalauncher/widgets/')], env=env, start_new_session=True)
    elif "Check widgets" in chosen:
        widgets_dir = os.path.expanduser("~/.config/omalauncher/widgets")
        files = [f for f in glob.glob(os.path.join(widgets_dir, "*.owl")) if not os.path.basename(f).startswith('.')]
        res = subprocess.run(['owl-check'] + files, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        msg = "Widgets OK" if res.returncode == 0 else "Check the errors"
        subprocess.run(['notify-send', '-a', 'omarchy', ' owl-check', f'{msg}\n{res.stdout.strip()[:200]}'])
    elif "Android app launcher" in chosen:
        subprocess.Popen(['/root/.local/bin/omarchy-android-menu'], env=env, start_new_session=True)

if __name__ == '__main__':
    main()
