#!/usr/bin/env python3
import json
import os

candidates = [
    "/run/user/0/android-status.json",
    os.path.expanduser("~/.local/share/omarchy/android-status.json"),
]

level = 100
status = "discharging"
temp = None

for path in candidates:
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            bat = data.get("battery", {})
            level = int(bat.get("level", 100))
            status = str(bat.get("status", "discharging")).lower()
            temp = bat.get("temperature")
            break
        except Exception:
            pass

charging_icons = ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
default_icons = ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]

idx = min(9, max(0, (level - 1) // 10))
if status in ("charging", "full"):
    icon = charging_icons[idx]
    cls = "charging"
else:
    icon = default_icons[idx]
    if level <= 15:
        cls = "critical"
    elif level <= 25:
        cls = "warning"
    else:
        cls = "discharging"

tooltip = f"Android battery: {level}% ({status})"
if temp is not None:
    tooltip += f"\nTemperatura: {temp}°C"

print(json.dumps({
    "text": f"{icon} {level}%",
    "tooltip": tooltip,
    "class": cls,
    "percentage": level
}))
